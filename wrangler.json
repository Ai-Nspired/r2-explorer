{
  "name": "r2-explorer",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "r2-explorer-bucket"
    }
  ]
}
